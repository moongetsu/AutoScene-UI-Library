{
  "name": "@moongetsu/autoscene-ui",
  "version": "1.0.3",
  "description": "Clean, lightweight, dark-mode desktop UI component library for React",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "bin": {
    "autoscene-ui": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src/components/ui",
    "src/components/brand/DiscordMark.tsx",
    "src/components/icons.ts",
    "src/lib/context-areas.ts",
    "src/lib/errors.ts",
    "src/lib/grid.ts",
    "src/lib/motion.ts",
    "src/lib/open-logs.ts",
    "src/lib/top-bar-rail.ts",
    "src/lib/ua.ts",
    "src/lib/utils.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build && node scripts/prerender-routes.mjs",
    "build:lib": "vite build --config vite.config.lib.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint && node scripts/check-deps.mjs",
    "sync:contributors": "node scripts/sync-contributors.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@phosphor-icons/react": ">=2.0.0",
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0"
  },
  "dependencies": {
    "@animate-ui/react": "2.4.2",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-virtual": "3.14.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "motion": "14.2.0",
    "radix-ui": "1.8.2-rc.1791984254107",
    "react-resizable-panels": "4.14.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0-dev.8396cc3d1f18c143a608a08ce8d2ca7487aa7b75",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "0.0.0-insiders.1a38f84",
    "@tauri-apps/api": "3.0.0-alpha.2",
    "@tauri-apps/plugin-dialog": "3.0.0-alpha.3",
    "@tauri-apps/plugin-opener": "3.0.0-alpha.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "0.0.0-insiders.1a38f84",
    "typescript": "7.1.0-dev.20261013.1",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@radix-ui/react-context": "1.3.1-rc.1791984254107",
    "@radix-ui/react-dialog": "1.3.2-rc.1791984254107",
    "@radix-ui/react-dismissable-layer": "1.2.2-rc.1791984254107",
    "@radix-ui/react-focus-scope": "1.3.2-rc.1791984254107"
  }
}
